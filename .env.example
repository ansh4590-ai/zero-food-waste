# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...          # Use the new sb_publishable_ format
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...             # NEVER expose client-side (no VITE_ prefix)

# ── GOOGLE GEMINI ─────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── GOOGLE CLOUD VISION (KYC OCR) ────────────────────────────────────────────
# Path to your downloaded GCP service-account JSON key file.
# On a server, store the key content in a secret and write it to a file at deploy time.
# Rotate this key if it has ever left your machine (e.g. via a chat/agent session).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-cloud-key.json

# ── AWS REKOGNITION (KYC face match) ─────────────────────────────────────────
# Get from: AWS IAM → your user → Security credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── FIREBASE (client-side auth) ───────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── APP CONFIG ────────────────────────────────────────────────────────────────
# The public URL of your deployed frontend — used to build the CORS allow-list.
# Set this in your host's environment variable panel (Vercel, Render, Railway, etc.)
APP_URL=https://your-app.vercel.app

NODE_ENV=production

# Port to listen on. Most PaaS platforms (Cloud Run, Render, Railway) set this automatically.
PORT=3000

# ── SECRETS ───────────────────────────────────────────────────────────────────
# Required to create admin accounts via /api/auth/register-admin
ADMIN_SECRET_KEY=

# Required to call /api/tasks/cleanup-stale (pass as ?key= parameter, or Authorization: Bearer <token>)
# Set this on your cron job / scheduler and in your host's environment.
CRON_SECRET=
