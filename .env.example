# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...          # Use the new sb_publishable_ format
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...             # NEVER expose client-side (no VITE_ prefix)

# ── GOOGLE GEMINI ─────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override the AI model (optional — defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── GOOGLE CLOUD VISION (KYC OCR) ────────────────────────────────────────────
# On Vercel: set GOOGLE_CREDENTIALS_JSON to the base64-encoded content of
# your GCP service-account JSON key file.
#   Linux/macOS: base64 -w0 key.json
#   Windows:     [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GOOGLE_CREDENTIALS_JSON=
# For local development only, you can still use a file path:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-cloud-key.json

# ── AWS REKOGNITION (KYC face match) ─────────────────────────────────────────
# Get from: AWS IAM → your user → Security credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── APP CONFIG ────────────────────────────────────────────────────────────────
# The public URL of your deployed frontend — used to build the CORS allow-list.
# Set this in your host's environment variable panel (Vercel, Render, Railway, etc.)
APP_URL=https://your-app.vercel.app

NODE_ENV=production

# Port to listen on. Most PaaS platforms (Cloud Run, Render, Railway) set this automatically.
PORT=3000

# ── SECRETS ───────────────────────────────────────────────────────────────────
# Required to create admin accounts via /api/auth/register-admin
ADMIN_SECRET_KEY=

# Set to true to allow new admin registrations via /api/auth/register-admin
# Leave false (or unset) in production unless actively onboarding an admin.
ADMIN_REGISTRATION_ENABLED=false

# Required to call /api/tasks/cleanup-stale (pass as Authorization: Bearer <token>)
# Set this in your host's environment and in the GitHub Actions repo secret CRON_SECRET.
CRON_SECRET=
